<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/help_sheet_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/help_sheet_sub"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipHelpGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_h_adopt"
            style="@style/Widget.PawHope.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/help_adopt" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_h_foster"
            style="@style/Widget.PawHope.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_foster" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_h_food"
            style="@style/Widget.PawHope.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_food" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_h_medical"
            style="@style/Widget.PawHope.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_medical" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_h_visit"
            style="@style/Widget.PawHope.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_visit" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.PawHope.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_help_message">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/helpMessageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendHelp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:text="@string/btn_send_offer"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_color"
        app:cornerRadius="14dp" />
</LinearLayout>